<?xml version="1.0"?>
<Container version="2">
  <Name>usb-gateway</Name>
  <Repository>ghcr.io/thaihoang987/usb-gateway:latest</Repository>
  <Registry>https://github.com/thaihoang987/usb-gateway/pkgs/container/usb-gateway</Registry>
  <Network>host</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>true</Privileged>
  <Support>https://github.com/thaihoang987/usb-gateway/issues</Support>
  <Project>https://github.com/thaihoang987/usb-gateway</Project>
  <ReadMe>https://github.com/thaihoang987/usb-gateway#readme</ReadMe>
  <Overview>USB Gateway quan ly nhieu Modbus TCP to RTU va Raw TCP to UART tu mot Web UI.</Overview>
  <Category>Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8098]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/thaihoang987/usb-gateway/master/unraid/my-usb-gateway.xml</TemplateURL>
  <Icon>/mnt/user/App_Custom/Icon_app/usb manager.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/usb-gateway" Mode="rw" Description="Cau hinh gateway luu ben vung" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/usb-gateway</Config>
  <Config Name="Thu muc Serial" Target="/dev/serial" Default="/dev/serial" Mode="ro" Description="Symlink by-id va by-path cua USB serial" Type="Path" Display="always" Required="true" Mask="false">/dev/serial</Config>
  <Config Name="Web UI Port" Target="WEB_PORT" Default="8098" Mode="" Description="Cong giao dien quan ly; app dung host network" Type="Variable" Display="always" Required="true" Mask="false">8098</Config>
  <Config Name="Config Path" Target="CONFIG_PATH" Default="/config/config.json" Mode="" Description="File cau hinh ben trong container" Type="Variable" Display="advanced" Required="true" Mask="false">/config/config.json</Config>
  <TailscaleStateDir/>
</Container>
